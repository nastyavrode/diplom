# Только ОДНА строка EXPO_PUBLIC_API_URL — дубликаты ломают настройку (берётся последняя).
# IP должен быть адрес компьютера в домашней Wi‑Fi (часто 192.168.x.x), не VPN (не 198.18.x.x).
# Узнать: ipconfig getifaddr en0   или   Настройки → Сеть → Wi‑Fi

EXPO_PUBLIC_API_URL=http://192.168.0.153:5050/api/auth
